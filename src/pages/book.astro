---
import Nav from "../components/Nav.astro";
import { ERROR_MESSAGES, listRooms } from "../lib/bookings";
import { slotRange } from "../lib/format";
import { rememberedEmail } from "../lib/remember";
import "../styles.css";

const params = Astro.url.searchParams;
const roomId = Number(params.get("room"));
const date = params.get("date") ?? "";
const slotRaw = params.get("slot") ?? "";
const slot = Number(slotRaw);
const errorCode = params.get("error");
const errorMessage = errorCode ? (ERROR_MESSAGES[errorCode] ?? "Something went wrong. Try again.") : null;
const email = rememberedEmail(Astro.cookies);

const room = Number.isInteger(roomId) ? listRooms().find((r) => r.id === roomId) : undefined;
const hasTarget = room !== undefined && /^\d{4}-\d{2}-\d{2}$/.test(date) && Number.isInteger(slot);
const here = `${Astro.url.pathname}${Astro.url.search}`;
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Book a room</title>
  </head>
  <body>
    <Nav email={email} />
    <main>
      <h1>Book a room</h1>
      <p class="lede">No login — bookings are looked up by email.</p>
      {
        !hasTarget ? (
          <p>Pick a free slot from the <a href="/">availability grid</a> to book it.</p>
        ) : (
          <>
            {errorMessage && <p role="alert" class="error">{errorMessage}</p>}
            <div class="card">
              <p class="target">{room!.name}</p>
              <p class="target-meta">
                {room!.library} · {room!.capacity} seats{room!.equipment ? ` · ${room!.equipment.replaceAll(",", ", ")}` : ""}
              </p>
              <p class="target-meta">
                {date}, {slotRange(slot)}
              </p>
              <form method="post" action="/api/bookings">
                <input type="hidden" name="roomId" value={room!.id} />
                <input type="hidden" name="date" value={date} />
                <input type="hidden" name="slot" value={slot} />
                <label>
                  Name
                  <input type="text" name="name" autocomplete="name" required />
                </label>
                <label>
                  ANU email
                  <input type="email" name="email" value={email} autocomplete="email" required />
                </label>
                <button type="submit">Confirm booking</button>
              </form>
            </div>
            {email && (
              <form method="post" action="/api/email/forget" class="not-you">
                <input type="hidden" name="next" value={here} />
                <span>Using {email}.</span>
                <button type="submit" class="link">Not you? Use a different email</button>
              </form>
            )}
            <p><a href={`/?date=${date}`}>← Back to the grid</a></p>
          </>
        )
      }
    </main>
  </body>
</html>
