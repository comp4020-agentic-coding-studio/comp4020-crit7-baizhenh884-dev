---
import {
  CLOSING_HOUR,
  currentSydneyHour,
  datePlusDays,
  isDateBookable,
  listBookingsForDate,
  listRooms,
  OPENING_HOUR,
  today,
} from "../lib/bookings";
import Nav from "../components/Nav.astro";
import { friendlyDate, hh, libraryClass, plural, shortRoomName, slotRange } from "../lib/format";
import "../styles.css";

const LIBRARIES = ["Chifley", "Hancock", "Menzies", "Law"];

const params = Astro.url.searchParams;
const requestedDate = params.get("date") ?? "";
const date = /^\d{4}-\d{2}-\d{2}$/.test(requestedDate) ? requestedDate : today();
const library = params.get("library") ?? "";
const minCapacityRaw = params.get("minCapacity") ?? "";
const minCapacity = minCapacityRaw ? Number(minCapacityRaw) : undefined;

const rooms = listRooms({
  library: library || undefined,
  minCapacity: minCapacity !== undefined && Number.isFinite(minCapacity) ? minCapacity : undefined,
});
const groups = LIBRARIES.map((lib) => ({ lib, rooms: rooms.filter((room) => room.library === lib) })).filter(
  (group) => group.rooms.length > 0,
);
const bookedSlots = new Set(listBookingsForDate(date).map((booking) => `${booking.roomId}:${booking.slot}`));
const slots = Array.from({ length: CLOSING_HOUR - OPENING_HOUR }, (_, i) => OPENING_HOUR + i);

// Mirrors the server's own rules so the grid never offers a slot createBooking would reject.
const todayStr = today();
const dateOpen = isDateBookable(date);
const isToday = date === todayStr;
const nowHour = currentSydneyHour();
const isUnavailable = (slot: number) => !dateOpen || (isToday && slot <= nowHour);
const nowSlot = isToday && nowHour >= OPENING_HOUR && nowHour < CLOSING_HOUR ? nowHour : undefined;

const freeCount = rooms.reduce(
  (total, room) =>
    total + slots.filter((slot) => !bookedSlots.has(`${room.id}:${slot}`) && !isUnavailable(slot)).length,
  0,
);

// Date shortcuts keep whatever library / seat filters are already applied.
// ‹ › only point inside the booking window, so the set of reachable pages
// stays finite for crawlers such as CI's recursive link check.
const realDate = friendlyDate(date) !== date;
const prevDate = realDate ? datePlusDays(date, -1) : undefined;
const nextDate = realDate ? datePlusDays(date, 1) : undefined;
const dateHref = (target: string) => {
  const query = new URLSearchParams({ date: target });
  if (library) query.set("library", library);
  if (minCapacityRaw) query.set("minCapacity", minCapacityRaw);
  return `/?${query}`;
};
const tomorrowStr = datePlusDays(todayStr, 1);
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Room availability</title>
  </head>
  <body>
    <Nav current="availability" />
    <main class="wide">
      <h1>Room availability</h1>
      <p class="lede">
        Every group study room across Chifley, Hancock, Menzies and Law, in one grid. Filter, then pick a free
        slot to book it.
      </p>
      <form method="get" class="filters">
        <div class="date-field">
          <label>
            <span>Date</span>
            <input type="date" name="date" value={date} />
          </label>
          <nav class="date-nav" aria-label="Change date">
            {prevDate && isDateBookable(prevDate) && <a href={dateHref(prevDate)} aria-label="Previous day">‹</a>}
            <a href={dateHref(todayStr)} aria-current={isToday ? "date" : undefined}>Today</a>
            <a href={dateHref(tomorrowStr)} aria-current={date === tomorrowStr ? "date" : undefined}>Tomorrow</a>
            {nextDate && isDateBookable(nextDate) && <a href={dateHref(nextDate)} aria-label="Next day">›</a>}
          </nav>
        </div>
        <label>
          <span>Library</span>
          <select name="library">
            <option value="" selected={library === ""}>All libraries</option>
            {
              LIBRARIES.map((lib) => (
                <option value={lib} selected={library === lib}>
                  {lib}
                </option>
              ))
            }
          </select>
        </label>
        <label>
          <span>Min. seats</span>
          <input type="number" name="minCapacity" min="1" value={minCapacityRaw} />
        </label>
        <button type="submit">Filter</button>
      </form>

      {
        groups.length === 0 ? (
          <div class="card empty">
            <p>No rooms match those filters.</p>
            <p><a href={`/?date=${date}`}>Clear filters</a></p>
          </div>
        ) : (
          <>
            <div class="grid-meta">
              <p class="summary">
                <strong>{plural(rooms.length, "room")}</strong> · <strong>{plural(freeCount, "free slot")}</strong> on {friendlyDate(date)}
              </p>
              <ul class="legend" aria-label="Legend">
                <li><span class="swatch slot-free" aria-hidden="true"></span>Free</li>
                <li><span class="swatch slot-booked" aria-hidden="true"></span>Booked</li>
                <li><span class="swatch slot-past" aria-hidden="true"></span>Unavailable</li>
              </ul>
            </div>
            {!dateOpen && (
              <p class="notice">Bookings are only open from today up to 14 days ahead, so nothing on {friendlyDate(date)} can be booked.</p>
            )}
            <div class="grid-scroll" role="region" aria-label={`Availability for ${date}`} tabindex="0">
              <table class="grid">
                <caption class="visually-hidden">Availability for {date}</caption>
                <thead>
                  <tr>
                    <th scope="col" class="corner">Room</th>
                    {slots.map((slot) => (
                      <th scope="col" class={slot === nowSlot ? "now" : undefined}>
                        {hh(slot)}
                        {slot === nowSlot && <span class="now-badge">now</span>}
                      </th>
                    ))}
                  </tr>
                </thead>
                {groups.map((group) => (
                  <tbody class={libraryClass(group.lib)}>
                    <tr class="library-row">
                      <th scope="rowgroup" colspan={slots.length + 1}>
                        <span>
                          <span class="lib-tag">{group.lib}</span>
                          <span class="lib-count">{plural(group.rooms.length, "room")}</span>
                        </span>
                      </th>
                    </tr>
                    {group.rooms.map((room) => {
                      const short = shortRoomName(room.name, room.library);
                      const label = [
                        short,
                        `${room.capacity} seats`,
                        ...(room.equipment ? [room.equipment.replaceAll(",", ", ")] : []),
                      ].join(" · ");
                      return (
                        <tr>
                          <th scope="row" class="room">{label}</th>
                          {slots.map((slot) => {
                            const now = slot === nowSlot ? "now-col" : undefined;
                            if (bookedSlots.has(`${room.id}:${slot}`)) {
                              return <td class={now}><span class="slot slot-booked">Booked</span></td>;
                            }
                            if (isUnavailable(slot)) {
                              return (
                                <td class={now}>
                                  <span class="slot slot-past">
                                    <span aria-hidden="true">–</span>
                                    <span class="visually-hidden">Unavailable</span>
                                  </span>
                                </td>
                              );
                            }
                            return (
                              <td>
                                <a
                                  class="slot slot-free"
                                  href={`/book?room=${room.id}&date=${date}&slot=${slot}`}
                                  title={`${short} · ${slotRange(slot)}`}
                                >
                                  Free<span class="visually-hidden"> — book {room.name} at {hh(slot)}</span>
                                </a>
                              </td>
                            );
                          })}
                        </tr>
                      );
                    })}
                  </tbody>
                ))}
              </table>
            </div>
          </>
        )
      }
    </main>
  </body>
</html>
