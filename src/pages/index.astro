---
import { CLOSING_HOUR, listBookingsForDate, listRooms, OPENING_HOUR, today } from "../lib/bookings";
import "../styles.css";

const LIBRARIES = ["Chifley", "Hancock", "Menzies", "Law"];

const params = Astro.url.searchParams;
const requestedDate = params.get("date") ?? "";
const date = /^\d{4}-\d{2}-\d{2}$/.test(requestedDate) ? requestedDate : today();
const library = params.get("library") ?? "";
const minCapacityRaw = params.get("minCapacity") ?? "";
const minCapacity = minCapacityRaw ? Number(minCapacityRaw) : undefined;

const rooms = listRooms({
  library: library || undefined,
  minCapacity: minCapacity !== undefined && Number.isFinite(minCapacity) ? minCapacity : undefined,
});
const bookedSlots = new Set(listBookingsForDate(date).map((booking) => `${booking.roomId}:${booking.slot}`));
const slots = Array.from({ length: CLOSING_HOUR - OPENING_HOUR }, (_, i) => OPENING_HOUR + i);
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Room availability</title>
  </head>
  <body>
    <nav aria-label="site">
      <a href="/">Availability</a>
      <a href="/bookings">My bookings</a>
      <a href="/readme/">About</a>
    </nav>
    <main>
      <h1>Room availability</h1>
      <p>
        Every group study room across Chifley, Hancock, Menzies and Law, in one
        grid. Filter, then click a free slot to book it — no login required to
        look.
      </p>
      <form method="get">
        <label>
          Date
          <input type="date" name="date" value={date} />
        </label>
        <label>
          Library
          <select name="library">
            <option value="" selected={library === ""}>All libraries</option>
            {
              LIBRARIES.map((lib) => (
                <option value={lib} selected={library === lib}>
                  {lib}
                </option>
              ))
            }
          </select>
        </label>
        <label>
          Min. capacity
          <input type="number" name="minCapacity" min="1" value={minCapacityRaw} />
        </label>
        <button type="submit">Filter</button>
      </form>

      {
        rooms.length === 0 ? (
          <p>No rooms match those filters.</p>
        ) : (
          <table>
            <caption>Availability for {date}</caption>
            <thead>
              <tr>
                <th scope="col">Room</th>
                {slots.map((slot) => (
                  <th scope="col">{slot}:00</th>
                ))}
              </tr>
            </thead>
            <tbody>
              {rooms.map((room) => (
                <tr>
                  <th scope="row">
                    {room.name} — {room.library} (cap. {room.capacity}
                    {room.equipment ? `, ${room.equipment.replaceAll(",", ", ")}` : ""})
                  </th>
                  {slots.map((slot) => {
                    const booked = bookedSlots.has(`${room.id}:${slot}`);
                    return <td>{booked ? "Booked" : <a href={`/book?room=${room.id}&date=${date}&slot=${slot}`}>Book</a>}</td>;
                  })}
                </tr>
              ))}
            </tbody>
          </table>
        )
      }
    </main>
  </body>
</html>
