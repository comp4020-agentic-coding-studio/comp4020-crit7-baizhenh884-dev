---
import { ERROR_MESSAGES, listBookingsForEmail, listRooms } from "../lib/bookings";
import "../styles.css";

const params = Astro.url.searchParams;
const email = params.get("email") ?? "";
const errorCode = params.get("error");
const errorMessage = errorCode ? (ERROR_MESSAGES[errorCode] ?? "Something went wrong. Try again.") : null;

const rooms = new Map(listRooms().map((room) => [room.id, room]));
const myBookings = email
  ? listBookingsForEmail(email).sort((a, b) => (a.date === b.date ? a.slot - b.slot : a.date < b.date ? -1 : 1))
  : [];
const hh = (h: number) => `${String(h).padStart(2, "0")}:00`;
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>My bookings</title>
  </head>
  <body>
    <nav aria-label="site">
      <a href="/">Availability</a>
      <a href="/bookings" aria-current="page">My bookings</a>
      <a href="/readme/">About</a>
    </nav>
    <main>
      <h1>My bookings</h1>
      <form method="get" class="filters">
        <label>
          ANU email
          <input type="email" name="email" value={email} autocomplete="email" required />
        </label>
        <button type="submit">Show my bookings</button>
      </form>
      {errorMessage && <p role="alert" class="error">{errorMessage}</p>}
      {email && myBookings.length === 0 && !errorMessage && <p class="notice">No bookings found for {email}.</p>}
      {
        myBookings.length > 0 && (
          <table class="list">
            <caption class="visually-hidden">Bookings for {email}</caption>
            <thead>
              <tr>
                <th scope="col">Room</th>
                <th scope="col">Date</th>
                <th scope="col">Time</th>
                <th scope="col"><span class="visually-hidden">Actions</span></th>
              </tr>
            </thead>
            <tbody>
              {myBookings.map((booking) => {
                const room = rooms.get(booking.roomId);
                return (
                  <tr>
                    <td>{room ? `${room.name} — ${room.library}` : `Room ${booking.roomId}`}</td>
                    <td>{booking.date}</td>
                    <td>
                      {hh(booking.slot)}–{hh(booking.slot + 1)}
                    </td>
                    <td>
                      <form method="post" action="/api/bookings/cancel">
                        <input type="hidden" name="id" value={booking.id} />
                        <input type="hidden" name="email" value={email} />
                        <button type="submit" class="secondary">Cancel</button>
                      </form>
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        )
      }
    </main>
  </body>
</html>
