---
import Nav from "../components/Nav.astro";
import { ERROR_MESSAGES, listBookingsForEmail, listRooms } from "../lib/bookings";
import { shortDate, shortRoomName, slotRange } from "../lib/format";
import { rememberEmail, rememberedEmail } from "../lib/remember";
import "../styles.css";

const params = Astro.url.searchParams;
const queried = (params.get("email") ?? "").trim().toLowerCase();
if (queried) rememberEmail(Astro.cookies, queried);
const email = queried || rememberedEmail(Astro.cookies);
const errorCode = params.get("error");
const errorMessage = errorCode ? (ERROR_MESSAGES[errorCode] ?? "Something went wrong. Try again.") : null;

const rooms = new Map(listRooms().map((room) => [room.id, room]));
const myBookings = queried
  ? listBookingsForEmail(queried).sort((a, b) => (a.date === b.date ? a.slot - b.slot : a.date < b.date ? -1 : 1))
  : [];

// Only ever matches one of this email's own bookings, so it can't reveal anyone else's.
const bookedId = Number(params.get("booked"));
const justBooked = myBookings.find((booking) => booking.id === bookedId);
const justBookedRoom = justBooked ? rooms.get(justBooked.roomId) : undefined;
const successMessage =
  justBooked && justBookedRoom
    ? `Booked ${shortRoomName(justBookedRoom.name, justBookedRoom.library)}, ${shortDate(justBooked.date)} ${slotRange(justBooked.slot)}`
    : null;
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>My bookings</title>
  </head>
  <body>
    <Nav current="bookings" email={email} />
    <main>
      <h1>My bookings</h1>
      <p class="lede">No login — bookings are looked up by email.</p>
      {successMessage && <p role="status" class="success">{successMessage}</p>}
      <form method="get" class="filters">
        <label>
          ANU email
          <input type="email" name="email" value={email} autocomplete="email" required />
        </label>
        <button type="submit">Show my bookings</button>
      </form>
      {
        email && (
          <form method="post" action="/api/email/forget" class="not-you">
            <input type="hidden" name="next" value="/bookings" />
            <span>Using {email}.</span>
            <button type="submit" class="link">Not you? Use a different email</button>
          </form>
        )
      }
      {errorMessage && <p role="alert" class="error">{errorMessage}</p>}
      {queried && myBookings.length === 0 && !errorMessage && <p class="notice">No bookings found for {queried}.</p>}
      {
        myBookings.length > 0 && (
          <table class="list">
            <caption class="visually-hidden">Bookings for {queried}</caption>
            <thead>
              <tr>
                <th scope="col">Room</th>
                <th scope="col">Date</th>
                <th scope="col">Time</th>
                <th scope="col"><span class="visually-hidden">Actions</span></th>
              </tr>
            </thead>
            <tbody>
              {myBookings.map((booking) => {
                const room = rooms.get(booking.roomId);
                return (
                  <tr class={booking.id === bookedId ? "highlight" : undefined}>
                    <td>{room ? `${room.name} — ${room.library}` : `Room ${booking.roomId}`}</td>
                    <td>{booking.date}</td>
                    <td>{slotRange(booking.slot)}</td>
                    <td>
                      <form method="post" action="/api/bookings/cancel">
                        <input type="hidden" name="id" value={booking.id} />
                        <input type="hidden" name="email" value={queried} />
                        <button type="submit" class="secondary">Cancel</button>
                      </form>
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        )
      }
    </main>
  </body>
</html>
